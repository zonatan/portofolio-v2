# Salin file ini menjadi .env.local lalu isi.
# Endpoint Formspree, contoh: https://formspree.io/f/abcdwxyz
# Jika kosong, form kontak otomatis memakai fallback mailto:.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# URL situs setelah deploy (dipakai untuk metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://zonatanx.vercel.app

# PIN untuk mengedit kutipan di balik kartu foto (WAJIB diisi; jika kosong, fitur edit nonaktif).
# Jangan tulis PIN asli di file ini — isi di .env.local dan di Environment Variables Vercel.
QUOTE_EDIT_PIN=

# Penyimpanan kutipan di produksi (Upstash Redis, gratis). Diisi otomatis jika
# memakai integrasi Upstash di Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
